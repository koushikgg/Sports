# Neon: pooled URL (host contains -pooler) for app + realtime runtime
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon: direct URL for migrations
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared secret used by web (signing socket tokens) and realtime (verifying them)
AUTH_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_PORT=4000
WEB_ORIGIN=http://localhost:3000
