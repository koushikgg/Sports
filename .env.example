# Neon: pooled URL (host contains -pooler) for app + realtime runtime
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon: direct URL for migrations
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared secret used by web (signing socket tokens) and realtime (verifying them)
AUTH_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5175,https://localhost:5173

# --- Google sign-in (Auth.js reads AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET) ---
# DUMMY values: replace with the OAuth client from Google Cloud Console.
# Authorised redirect URI to register: {your site}/api/auth/callback/google  (local: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=dummy-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=dummy-client-secret
# Comma-separated Google emails that become admins on their first sign-in. Use this to get the first admin in.
ADMIN_EMAILS=
# Optional: only emails from this domain may sign in (for example company.com).
ALLOWED_EMAIL_DOMAIN=
# Email + password sign-in is a fallback. Set to false once Google sign-in works.
AUTH_PASSWORD_LOGIN=true
